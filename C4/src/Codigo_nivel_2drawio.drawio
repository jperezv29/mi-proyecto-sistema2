        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% =====================================================\n%% ACTORES\n%% =====================================================\n\nADMIN[\&quot;👤 Administrador Electoral&lt;br/&gt;&lt;br/&gt;\nAdministra usuarios, roles,&lt;br/&gt;\nvotaciones, mesas y candidatos\&quot;]\n\nDIG[\&quot;👤 Digitador de Mesa&lt;br/&gt;&lt;br/&gt;\nRegistra votos y resultados&lt;br/&gt;\nobtenidos en cada mesa\&quot;]\n\nSUP[\&quot;👤 Supervisor Electoral&lt;br/&gt;&lt;br/&gt;\nConsulta avances, resultados&lt;br/&gt;\ne inconsistencias\&quot;]\n\nCIUD[\&quot;👤 Ciudadano / Votante&lt;br/&gt;&lt;br/&gt;\nConsulta candidatos,&lt;br/&gt;\nvotaciones y resultados\&quot;]\n\n\n%% =====================================================\n%% SISTEMA VOTAGT\n%% =====================================================\n\nsubgraph VOTAGT[\&quot;VotaGT - Sistema de Gestión Electoral\&quot;]\n\n    WEB[\&quot;🌐 Aplicación Web VotaGT&lt;br/&gt;&lt;br/&gt;\n    Contenedor Web&lt;br/&gt;&lt;br/&gt;\n    PHP / HTML / CSS / JavaScript&lt;br/&gt;&lt;br/&gt;\n    Interfaz para administración,&lt;br/&gt;\n    registro y consulta electoral\&quot;]\n\n    MOBILE[\&quot;📱 Aplicación Móvil&lt;br/&gt;&lt;br/&gt;\n    Contenedor Cliente&lt;br/&gt;&lt;br/&gt;\n    Permite consultar información&lt;br/&gt;\n    electoral desde dispositivos móviles\&quot;]\n\n    BACKEND[\&quot;⚙️ Backend API REST VotaGT&lt;br/&gt;&lt;br/&gt;\n    Contenedor - Monolito Modular&lt;br/&gt;&lt;br/&gt;\n    Autenticación e Identidad&lt;br/&gt;\n    Control de Acceso&lt;br/&gt;\n    Votaciones&lt;br/&gt;\n    Candidatos&lt;br/&gt;\n    Mesas&lt;br/&gt;\n    Resultados&lt;br/&gt;\n    Reportes&lt;br/&gt;\n    Auditoría\&quot;]\n\n    REDIS[(\&quot;⚡ Redis&lt;br/&gt;&lt;br/&gt;\n    Caché&lt;br/&gt;\n    Rate Limiting&lt;br/&gt;\n    Datos temporales\&quot;)]\n\n    IDENTITY[(\&quot;🔐 IdentityDB&lt;br/&gt;&lt;br/&gt;\n    Usuarios&lt;br/&gt;\n    Credenciales&lt;br/&gt;\n    Roles&lt;br/&gt;\n    Permisos&lt;br/&gt;\n    Sesiones\&quot;)]\n\n    ELECTION[(\&quot;🗳️ ElectionDB&lt;br/&gt;&lt;br/&gt;\n    Base de Datos Operacional&lt;br/&gt;&lt;br/&gt;\n    Votaciones&lt;br/&gt;\n    Candidatos&lt;br/&gt;\n    Mesas&lt;br/&gt;\n    Resultados\&quot;)]\n\n    REPORTING[(\&quot;📊 ReportingDB&lt;br/&gt;&lt;br/&gt;\n    Estadísticas&lt;br/&gt;\n    Agregaciones&lt;br/&gt;\n    Resultados consolidados&lt;br/&gt;\n    Reportes\&quot;)]\n\n    AUDIT[(\&quot;📋 AuditDB&lt;br/&gt;&lt;br/&gt;\n    Eventos&lt;br/&gt;\n    Historial de operaciones&lt;br/&gt;\n    Cambios&lt;br/&gt;\n    Trazabilidad\&quot;)]\n\nend\n\n\n%% =====================================================\n%% SISTEMAS EXTERNOS\n%% =====================================================\n\nMEDIA[\&quot;📰 Medio de Comunicación&lt;br/&gt;&lt;br/&gt;\nConsulta resultados consolidados&lt;br/&gt;\npara prensa, televisión&lt;br/&gt;\no portales digitales\&quot;]\n\nENTITY[\&quot;🏛️ Institución Electoral Externa&lt;br/&gt;&lt;br/&gt;\nIntegra información de VotaGT&lt;br/&gt;\ncon sistemas institucionales\&quot;]\n\nAPP[\&quot;🖥️ Aplicación / Portal Externo&lt;br/&gt;&lt;br/&gt;\nConsume votaciones,&lt;br/&gt;\ncandidatos y resultados&lt;br/&gt;\nmediante la API REST\&quot;]\n\nMAIL[\&quot;✉️ Servicio de Correo&lt;br/&gt;&lt;br/&gt;\nSistema externo&lt;br/&gt;&lt;br/&gt;\nRecuperación de contraseña&lt;br/&gt;\ny notificaciones\&quot;]\n\n\n%% =====================================================\n%% INTERACCIÓN DE USUARIOS\n%% =====================================================\n\nADMIN --&gt;|\&quot;HTTPS&lt;br/&gt;Administración\&quot;| WEB\n\nDIG --&gt;|\&quot;HTTPS&lt;br/&gt;Registro de resultados\&quot;| WEB\n\nSUP --&gt;|\&quot;HTTPS&lt;br/&gt;Consulta y supervisión\&quot;| WEB\n\nCIUD --&gt;|\&quot;HTTPS&lt;br/&gt;Consulta pública\&quot;| WEB\n\nCIUD --&gt;|\&quot;HTTPS\&quot;| MOBILE\n\n\n%% =====================================================\n%% FRONTEND HACIA BACKEND\n%% =====================================================\n\nWEB --&gt;|\&quot;JSON / HTTPS&lt;br/&gt;Solicitudes REST\&quot;| BACKEND\n\nMOBILE --&gt;|\&quot;JSON / HTTPS&lt;br/&gt;Solicitudes REST\&quot;| BACKEND\n\n\n%% =====================================================\n%% BACKEND Y DATOS\n%% =====================================================\n\nBACKEND --&gt;|\&quot;Autentica usuarios&lt;br/&gt;y valida permisos\&quot;| IDENTITY\n\nBACKEND --&gt;|\&quot;Lee y registra&lt;br/&gt;información electoral\&quot;| ELECTION\n\nBACKEND --&gt;|\&quot;Consulta estadísticas&lt;br/&gt;y reportes\&quot;| REPORTING\n\nBACKEND --&gt;|\&quot;Registra y consulta&lt;br/&gt;trazabilidad\&quot;| AUDIT\n\nBACKEND --&gt;|\&quot;Caché y&lt;br/&gt;control de solicitudes\&quot;| REDIS\n\n\n%% =====================================================\n%% SINCRONIZACIÓN Y EVENTOS\n%% =====================================================\n\nELECTION --&gt;|\&quot;Eventos / sincronización&lt;br/&gt;de información\&quot;| REPORTING\n\nELECTION --&gt;|\&quot;Transactional Outbox&lt;br/&gt;Eventos de auditoría\&quot;| AUDIT\n\n\n%% =====================================================\n%% SERVICIO EXTERNO\n%% =====================================================\n\nBACKEND --&gt;|\&quot;HTTPS / API&lt;br/&gt;Recuperación y notificaciones\&quot;| MAIL\n\n\n%% =====================================================\n%% INTEGRACIONES EXTERNAS\n%% =====================================================\n\nMEDIA --&gt;|\&quot;JSON / HTTPS&lt;br/&gt;Consulta resultados\&quot;| BACKEND\n\nENTITY --&gt;|\&quot;JSON / HTTPS + JWT&lt;br/&gt;Integración institucional\&quot;| BACKEND\n\nAPP --&gt;|\&quot;JSON / HTTPS + JWT&lt;br/&gt;Votaciones, candidatos&lt;br/&gt;y resultados\&quot;| BACKEND\n\n\n%% =====================================================\n%% ESTILOS\n%% =====================================================\n\nclassDef actor fill:#123E4A,color:#ffffff,stroke:#123E4A,stroke-width:2px;\nclassDef frontend fill:#18546A,color:#ffffff,stroke:#123E4A,stroke-width:2px;\nclassDef backend fill:#0E6378,color:#ffffff,stroke:#084C5C,stroke-width:3px;\nclassDef database fill:#315D6B,color:#ffffff,stroke:#123E4A,stroke-width:2px;\nclassDef cache fill:#5E7180,color:#ffffff,stroke:#37474F,stroke-width:2px;\nclassDef external fill:#184E5C,color:#ffffff,stroke:#123E4A,stroke-width:2px;\n\nclass ADMIN,DIG,SUP,CIUD actor;\nclass WEB,MOBILE frontend;\nclass BACKEND backend;\nclass IDENTITY,ELECTION,REPORTING,AUDIT database;\nclass REDIS cache;\nclass MEDIA,ENTITY,APP,MAIL external;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="kk7Cj5sD1K4QoEuPQ1iu-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
