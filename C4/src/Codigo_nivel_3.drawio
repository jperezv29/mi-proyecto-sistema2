  <diagram name="Página-1" id="hKVxcQLJ_RURknWMIAWX">
    <mxGraphModel dx="5510" dy="2803" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% =====================================================\n%% CLIENTES QUE CONSUMEN EL BACKEND\n%% =====================================================\n\nCLIENT[\&quot;🌐 Clientes del Backend&lt;br/&gt;&lt;br/&gt;\nAplicación Web VotaGT&lt;br/&gt;\nAplicación Móvil&lt;br/&gt;\nSistemas Externos\&quot;]\n\n\n%% =====================================================\n%% BACKEND API REST - MONOLITO MODULAR\n%% =====================================================\n\nsubgraph BACKEND[\&quot;⚙️ Backend API REST VotaGT - Monolito Modular\&quot;]\n\n\n    %% ================================================\n    %% ENTRADA API\n    %% ================================================\n\n    ROUTER[\&quot;🔀 Router API REST&lt;br/&gt;&lt;br/&gt;\n    Recibe solicitudes HTTP&lt;br/&gt;\n    y dirige cada petición&lt;br/&gt;\n    al endpoint correspondiente\&quot;]\n\n\n    %% ================================================\n    %% MIDDLEWARES\n    %% ================================================\n\n    subgraph MIDDLEWARES[\&quot;🛡️ Middlewares\&quot;]\n\n        JWT[\&quot;JWT Middleware&lt;br/&gt;&lt;br/&gt;\n        Valida el token JWT&lt;br/&gt;\n        recibido en el encabezado\&quot;]\n\n        AUTHZ[\&quot;Authorization Middleware&lt;br/&gt;&lt;br/&gt;\n        Valida roles&lt;br/&gt;\n        y permisos\&quot;]\n\n        VALID[\&quot;Validation Middleware&lt;br/&gt;&lt;br/&gt;\n        Verifica formato y&lt;br/&gt;\n        datos obligatorios\&quot;]\n\n        RATE[\&quot;Rate Limit Middleware&lt;br/&gt;&lt;br/&gt;\n        Controla cantidad&lt;br/&gt;\n        de solicitudes\&quot;]\n\n        ERROR[\&quot;Error Middleware&lt;br/&gt;&lt;br/&gt;\n        Centraliza manejo&lt;br/&gt;\n        de errores HTTP\&quot;]\n\n    end\n\n\n    %% ================================================\n    %% CONTROLADORES REST\n    %% ================================================\n\n    subgraph CONTROLLERS[\&quot;🎮 Controladores REST\&quot;]\n\n        AUTHC[\&quot;AuthController&lt;br/&gt;&lt;br/&gt;\n        Login y autenticación\&quot;]\n\n        VOTEC[\&quot;VotacionController&lt;br/&gt;&lt;br/&gt;\n        Gestión de votaciones\&quot;]\n\n        CANDC[\&quot;CandidatoController&lt;br/&gt;&lt;br/&gt;\n        Gestión de candidatos\&quot;]\n\n        MESAC[\&quot;MesaController&lt;br/&gt;&lt;br/&gt;\n        Gestión de mesas\&quot;]\n\n        RESC[\&quot;ResultadoController&lt;br/&gt;&lt;br/&gt;\n        Registro y consulta&lt;br/&gt;\n        de resultados\&quot;]\n\n        REPC[\&quot;ReporteController&lt;br/&gt;&lt;br/&gt;\n        Reportes y estadísticas\&quot;]\n\n    end\n\n\n    %% ================================================\n    %% DTOs\n    %% ================================================\n\n    subgraph DTOS[\&quot;📦 DTOs - Data Transfer Objects\&quot;]\n\n        AUTHDTO[\&quot;Auth DTOs&lt;br/&gt;&lt;br/&gt;\n        LoginRequest&lt;br/&gt;\n        LoginResponse\&quot;]\n\n        VOTEDTO[\&quot;Votación DTOs&lt;br/&gt;&lt;br/&gt;\n        VotacionCreateRequest&lt;br/&gt;\n        VotacionUpdateRequest&lt;br/&gt;\n        VotacionResponse\&quot;]\n\n        CANDDTO[\&quot;Candidato DTOs&lt;br/&gt;&lt;br/&gt;\n        CandidatoCreateRequest&lt;br/&gt;\n        CandidatoResponse\&quot;]\n\n        MESADTO[\&quot;Mesa DTOs&lt;br/&gt;&lt;br/&gt;\n        MesaCreateRequest&lt;br/&gt;\n        MesaResponse\&quot;]\n\n        RESDTO[\&quot;Resultado DTOs&lt;br/&gt;&lt;br/&gt;\n        ResultadoCreateRequest&lt;br/&gt;\n        ResultadoResponse\&quot;]\n\n        REPDTO[\&quot;Reporte DTOs&lt;br/&gt;&lt;br/&gt;\n        ReporteRequest&lt;br/&gt;\n        ReporteResponse\&quot;]\n\n    end\n\n\n    %% ================================================\n    %% SERVICIOS / CASOS DE USO\n    %% ================================================\n\n    subgraph SERVICES[\&quot;⚙️ Servicios de Aplicación\&quot;]\n\n        IDS[\&quot;IdentityService&lt;br/&gt;&lt;br/&gt;\n        Inicio de sesión&lt;br/&gt;\n        usuarios y sesiones\&quot;]\n\n        ACS[\&quot;AccessControlService&lt;br/&gt;&lt;br/&gt;\n        Roles, permisos&lt;br/&gt;\n        y autorización\&quot;]\n\n        VOTES[\&quot;VotacionService&lt;br/&gt;&lt;br/&gt;\n        Reglas de procesos&lt;br/&gt;\n        electorales\&quot;]\n\n        CANDS[\&quot;CandidatoService&lt;br/&gt;&lt;br/&gt;\n        Administración de&lt;br/&gt;\n        candidatos\&quot;]\n\n        MESAS[\&quot;MesaService&lt;br/&gt;&lt;br/&gt;\n        Administración de&lt;br/&gt;\n        mesas electorales\&quot;]\n\n        RESS[\&quot;ResultadoService&lt;br/&gt;&lt;br/&gt;\n        Registro, validación y&lt;br/&gt;\n        consolidación de resultados\&quot;]\n\n        REPS[\&quot;ReportingService&lt;br/&gt;&lt;br/&gt;\n        Estadísticas, reportes&lt;br/&gt;\n        y exportaciones CSV\&quot;]\n\n    end\n\n\n    %% ================================================\n    %% DOMINIO\n    %% ================================================\n\n    DOMAIN[\&quot;📐 Reglas de Dominio&lt;br/&gt;&lt;br/&gt;\n    Validaciones electorales&lt;br/&gt;\n    Reglas de negocio&lt;br/&gt;\n    Integridad de operaciones\&quot;]\n\n\n    %% ================================================\n    %% REPOSITORIOS\n    %% ================================================\n\n    subgraph REPOSITORIES[\&quot;🗄️ Repositorios\&quot;]\n\n        IDREPO[\&quot;IdentityRepository&lt;br/&gt;&lt;br/&gt;\n        Acceso a usuarios,&lt;br/&gt;\n        roles y permisos\&quot;]\n\n        ELECREPO[\&quot;ElectionRepository&lt;br/&gt;&lt;br/&gt;\n        Acceso a votaciones,&lt;br/&gt;\n        candidatos, mesas&lt;br/&gt;\n        y resultados\&quot;]\n\n        REPREPO[\&quot;ReportingRepository&lt;br/&gt;&lt;br/&gt;\n        Acceso a estadísticas&lt;br/&gt;\n        y datos consolidados\&quot;]\n\n        AUDREPO[\&quot;AuditRepository&lt;br/&gt;&lt;br/&gt;\n        Acceso a información&lt;br/&gt;\n        de auditoría\&quot;]\n\n    end\n\n\n    %% ================================================\n    %% EVENTOS Y AUDITORÍA\n    %% ================================================\n\n    EVENTS[\&quot;📨 Event Publisher&lt;br/&gt;&lt;br/&gt;\n    Genera eventos internos&lt;br/&gt;\n    de operaciones relevantes\&quot;]\n\n    OUTBOX[\&quot;📬 Transactional Outbox&lt;br/&gt;&lt;br/&gt;\n    Garantiza persistencia&lt;br/&gt;\n    de eventos pendientes\&quot;]\n\nend\n\n\n%% =====================================================\n%% INFRAESTRUCTURA\n%% =====================================================\n\nREDIS[(\&quot;⚡ Redis&lt;br/&gt;&lt;br/&gt;\nCaché&lt;br/&gt;\nRate Limiting&lt;br/&gt;\nDatos temporales\&quot;)]\n\nIDENTITY[(\&quot;🔐 IdentityDB&lt;br/&gt;&lt;br/&gt;\nUsuarios&lt;br/&gt;\nCredenciales&lt;br/&gt;\nRoles&lt;br/&gt;\nPermisos&lt;br/&gt;\nSesiones\&quot;)]\n\nELECTION[(\&quot;🗳️ ElectionDB&lt;br/&gt;&lt;br/&gt;\nVotaciones&lt;br/&gt;\nCandidatos&lt;br/&gt;\nMesas&lt;br/&gt;\nResultados\&quot;)]\n\nREPORTING[(\&quot;📊 ReportingDB&lt;br/&gt;&lt;br/&gt;\nEstadísticas&lt;br/&gt;\nAgregaciones&lt;br/&gt;\nResultados consolidados&lt;br/&gt;\nReportes\&quot;)]\n\nAUDIT[(\&quot;📋 AuditDB&lt;br/&gt;&lt;br/&gt;\nEventos&lt;br/&gt;\nHistorial&lt;br/&gt;\nCambios&lt;br/&gt;\nTrazabilidad\&quot;)]\n\nMAIL[\&quot;✉️ Servicio de Correo&lt;br/&gt;&lt;br/&gt;\nRecuperación de contraseña&lt;br/&gt;\ny notificaciones\&quot;]\n\n\n%% =====================================================\n%% FLUJO DE ENTRADA\n%% =====================================================\n\nCLIENT --&gt;|\&quot;JSON / HTTPS\&quot;| ROUTER\n\nROUTER --&gt; JWT\nJWT --&gt; AUTHZ\nAUTHZ --&gt; VALID\nVALID --&gt; RATE\n\n\n%% =====================================================\n%% MIDDLEWARES HACIA CONTROLADORES\n%% =====================================================\n\nRATE --&gt; AUTHC\nRATE --&gt; VOTEC\nRATE --&gt; CANDC\nRATE --&gt; MESAC\nRATE --&gt; RESC\nRATE --&gt; REPC\n\n\n%% =====================================================\n%% CONTROLADORES Y DTOs\n%% =====================================================\n\nAUTHC &lt;--&gt;|\&quot;Request / Response\&quot;| AUTHDTO\nVOTEC &lt;--&gt;|\&quot;Request / Response\&quot;| VOTEDTO\nCANDC &lt;--&gt;|\&quot;Request / Response\&quot;| CANDDTO\nMESAC &lt;--&gt;|\&quot;Request / Response\&quot;| MESADTO\nRESC &lt;--&gt;|\&quot;Request / Response\&quot;| RESDTO\nREPC &lt;--&gt;|\&quot;Request / Response\&quot;| REPDTO\n\n\n%% =====================================================\n%% CONTROLADORES HACIA SERVICIOS\n%% =====================================================\n\nAUTHC --&gt;|\&quot;Ejecuta caso de uso\&quot;| IDS\n\nVOTEC --&gt;|\&quot;Ejecuta caso de uso\&quot;| VOTES\n\nCANDC --&gt;|\&quot;Ejecuta caso de uso\&quot;| CANDS\n\nMESAC --&gt;|\&quot;Ejecuta caso de uso\&quot;| MESAS\n\nRESC --&gt;|\&quot;Ejecuta caso de uso\&quot;| RESS\n\nREPC --&gt;|\&quot;Ejecuta caso de uso\&quot;| REPS\n\n\n%% =====================================================\n%% AUTORIZACIÓN\n%% =====================================================\n\nAUTHZ --&gt;|\&quot;Consulta autorización\&quot;| ACS\n\nACS --&gt; IDREPO\n\n\n%% =====================================================\n%% REGLAS DE DOMINIO\n%% =====================================================\n\nVOTES --&gt; DOMAIN\nCANDS --&gt; DOMAIN\nMESAS --&gt; DOMAIN\nRESS --&gt; DOMAIN\n\n\n%% =====================================================\n%% SERVICIOS HACIA REPOSITORIOS\n%% =====================================================\n\nIDS --&gt; IDREPO\n\nVOTES --&gt; ELECREPO\nCANDS --&gt; ELECREPO\nMESAS --&gt; ELECREPO\nRESS --&gt; ELECREPO\n\nREPS --&gt; REPREPO\n\n\n%% =====================================================\n%% REPOSITORIOS HACIA BASES DE DATOS\n%% =====================================================\n\nIDREPO --&gt;|\&quot;Lee / escribe identidad\&quot;| IDENTITY\n\nELECREPO --&gt;|\&quot;Lee / escribe información electoral\&quot;| ELECTION\n\nREPREPO --&gt;|\&quot;Consulta información analítica\&quot;| REPORTING\n\nAUDREPO --&gt;|\&quot;Registra trazabilidad\&quot;| AUDIT\n\n\n%% =====================================================\n%% REDIS\n%% =====================================================\n\nRATE --&gt;|\&quot;Control de solicitudes\&quot;| REDIS\n\nIDS --&gt;|\&quot;Sesiones / datos temporales\&quot;| REDIS\n\nREPS --&gt;|\&quot;Caché de consultas\&quot;| REDIS\n\n\n%% =====================================================\n%% EVENTOS\n%% =====================================================\n\nVOTES --&gt;|\&quot;Genera evento\&quot;| EVENTS\nCANDS --&gt;|\&quot;Genera evento\&quot;| EVENTS\nMESAS --&gt;|\&quot;Genera evento\&quot;| EVENTS\nRESS --&gt;|\&quot;Genera evento\&quot;| EVENTS\n\nEVENTS --&gt; OUTBOX\n\nOUTBOX --&gt;|\&quot;Evento de auditoría\&quot;| AUDREPO\n\nOUTBOX --&gt;|\&quot;Actualiza modelo de lectura\&quot;| REPREPO\n\n\n%% =====================================================\n%% SINCRONIZACIÓN\n%% =====================================================\n\nELECREPO --&gt;|\&quot;Registra evento Outbox\&quot;| OUTBOX\n\n\n%% =====================================================\n%% CORREO\n%% =====================================================\n\nIDS --&gt;|\&quot;Recuperación de contraseña\&quot;| MAIL\n\n\n%% =====================================================\n%% MANEJO DE ERRORES\n%% =====================================================\n\nAUTHC -.-&gt; ERROR\nVOTEC -.-&gt; ERROR\nCANDC -.-&gt; ERROR\nMESAC -.-&gt; ERROR\nRESC -.-&gt; ERROR\nREPC -.-&gt; ERROR\n\nERROR --&gt;|\&quot;Respuesta HTTP&lt;br/&gt;400 / 401 / 404 / 500\&quot;| CLIENT\n\n\n%% =====================================================\n%% ESTILOS\n%% =====================================================\n\nclassDef client fill:#123E4A,color:#ffffff,stroke:#123E4A,stroke-width:2px;\n\nclassDef router fill:#1B5366,color:#ffffff,stroke:#123E4A,stroke-width:2px;\n\nclassDef middleware fill:#5A6470,color:#ffffff,stroke:#37474F,stroke-width:2px;\n\nclassDef controller fill:#18546A,color:#ffffff,stroke:#123E4A,stroke-width:2px;\n\nclassDef dto fill:#657A86,color:#ffffff,stroke:#455A64,stroke-width:2px;\n\nclassDef service fill:#0E6378,color:#ffffff,stroke:#084C5C,stroke-width:2px;\n\nclassDef domain fill:#326B72,color:#ffffff,stroke:#17484E,stroke-width:2px;\n\nclassDef repository fill:#395F6B,color:#ffffff,stroke:#123E4A,stroke-width:2px;\n\nclassDef event fill:#626A73,color:#ffffff,stroke:#37474F,stroke-width:2px;\n\nclassDef database fill:#315D6B,color:#ffffff,stroke:#123E4A,stroke-width:2px;\n\nclassDef cache fill:#596B76,color:#ffffff,stroke:#37474F,stroke-width:2px;\n\nclassDef external fill:#184E5C,color:#ffffff,stroke:#123E4A,stroke-width:2px;\n\n\nclass CLIENT client;\n\nclass ROUTER router;\n\nclass JWT,AUTHZ,VALID,RATE,ERROR middleware;\n\nclass AUTHC,VOTEC,CANDC,MESAC,RESC,REPC controller;\n\nclass AUTHDTO,VOTEDTO,CANDDTO,MESADTO,RESDTO,REPDTO dto;\n\nclass IDS,ACS,VOTES,CANDS,MESAS,RESS,REPS service;\n\nclass DOMAIN domain;\n\nclass IDREPO,ELECREPO,REPREPO,AUDREPO repository;\n\nclass EVENTS,OUTBOX event;\n\nclass IDENTITY,ELECTION,REPORTING,AUDIT database;\n\nclass REDIS cache;\n\nclass MAIL external;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_W8bH3st7maqcuWhU9dK-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
